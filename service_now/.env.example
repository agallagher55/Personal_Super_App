# Copy this file to `.env` in this folder and fill in real values.
# `.env` is git-ignored — never commit real credentials.

# Instance hostname only, no scheme/path (from the dashboard URL you gave:
# https://halifaxprod.service-now.com/...).
SERVICENOW_INSTANCE=halifaxprod.service-now.com

# --- Option A: Basic auth (simplest for a personal script) ---
SERVICENOW_USER=your.username
SERVICENOW_PASSWORD=your-password

# --- Option B: OAuth bearer token (preferred if IT issues one) ---
# If set, SERVICENOW_TOKEN takes priority over SERVICENOW_USER/PASSWORD.
# SERVICENOW_TOKEN=

# sys_id of your sys_user record. If left blank, sync.py resolves it at
# runtime from SERVICENOW_USER via the sys_user table and prints it so
# you can pin it here (avoids one extra lookup on every run).
SERVICENOW_USER_SYS_ID=

# Table to sync from. sc_task covers the Catalog Task records shown in
# your GIS dashboard screenshots (TASK0329104, etc.).
SERVICENOW_TABLE=sc_task

# Optional: override the query entirely instead of the default
# "assigned_to=<your sys_id>^active=true". Use encoded query syntax,
# e.g. to also match your dashboard's "Additional Assignee List" and
# "Task type" exclusions once you confirm the real field names in your
# instance:
# SERVICENOW_QUERY=assigned_to=<sys_id>^ORu_additional_assignee_listLIKE<sys_id>^active=true

# Which section in data/tasks.json new/updated tasks land in.
SERVICENOW_SECTION_ID=own-tasks
