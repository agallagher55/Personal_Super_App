# Copy this file to `.env` in this folder and fill in real values.
# `.env` is git-ignored — never commit real credentials.

# Instance hostname only, no scheme/path (from the dashboard URL you gave:
# https://halifaxprod.service-now.com/...).
SERVICENOW_INSTANCE=halifaxprod.service-now.com

# --- Option A: Basic auth (simplest for a personal script) ---
SERVICENOW_USER=your.username
SERVICENOW_PASSWORD=your-password

# --- Option B: OAuth bearer token (preferred if IT issues one) ---
# If set, SERVICENOW_TOKEN takes priority over SERVICENOW_USER/PASSWORD.
# SERVICENOW_TOKEN=

# sys_id of your sys_user record. If left blank, sync.py resolves it at
# runtime from SERVICENOW_USER via the sys_user table and prints it so
# you can pin it here (avoids one extra lookup on every run).
SERVICENOW_USER_SYS_ID=

# Table to sync from. "task" is the base table -- the "My Work" list
# mixes several task-derived types (Catalog Task, Incident, etc.), so
# this queries across all of them and relies on sys_class_name filtering
# below to exclude the ones the dashboard excludes. Set to sc_task
# instead if you only ever want Catalog Tasks.
SERVICENOW_TABLE=task

# Optional: override the query entirely. Default (built in sync.py from
# SERVICENOW_USER_SYS_ID) mirrors the "My Work" dashboard filter:
#   (Assigned to = me OR Additional Assignee List contains me)
#   AND Active = true
#   AND Task type not in [Request, Requested Item, Group approval,
#                          KB Submission, Chat Queue Entry]
# As an encoded query that's:
# SERVICENOW_QUERY=assigned_to=<sys_id>^ORadditional_assignee_listLIKE<sys_id>^active=true^sys_class_name!=sc_request^sys_class_name!=sc_req_item^sys_class_name!=sysapproval_group^sys_class_name!=kb_submission^sys_class_name!=chat_queue_entry

# Which section in data/tasks.json new/updated tasks land in.
SERVICENOW_SECTION_ID=own-tasks
